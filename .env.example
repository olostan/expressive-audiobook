# Copy to .env and fill in. Never commit .env.
# Read from the environment first. This file is only a fallback.
# Needed only when text.provider or tts.provider is "gemini" (the default). Not needed for Ollama + Orpheus.
GEMINI_API_KEY=
# Optional: ElevenLabs sound effects. Only needed when the sfx provider is "elevenlabs".
ELEVENLABS_API_KEY=
